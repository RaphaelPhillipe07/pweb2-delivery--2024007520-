{
  "name": "pweb2-delivery",
  "version": "1.0.0",
  "description": "Delivery Tracker — Programação Web II (Node/Express) com persistência via Prisma + SQLite.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node autograder/check.mjs",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.10.0"
  }
}
