<p class="caminho"><a href="/motoristas">← Voltar para motoristas</a></p>

<h1>Novo Motorista</h1>

<%- include('../partials/erros', { erros: erros }) %>

<form class="formulario" method="POST" action="/motoristas">
  <div class="campo">
    <label for="nome">Nome</label>
    <input type="text" id="nome" name="nome" value="<%= dados.nome %>" maxlength="120" required autofocus>
  </div>

  <div class="campo">
    <label for="cpf">CPF</label>
    <input type="text" id="cpf" name="cpf" value="<%= dados.cpf %>" maxlength="20" required>
  </div>

  <div class="form-acoes">
    <button class="botao botao-primario" type="submit">Cadastrar motorista</button>
    <a class="botao" href="/motoristas">Cancelar</a>
  </div>
</form>
